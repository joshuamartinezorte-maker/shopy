{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--mt-color-fondo-alt);
  }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

<section class="mt-pasos mt-section">
  <div class="mt-container">
    <div class="mt-pasos__head mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<div class="mt-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="mt-h2">{{ section.settings.headline }}</h2>
    </div>

    <div class="mt-pasos__grid">
      {%- for block in section.blocks -%}
        <div class="mt-paso mt-reveal" style="transition-delay: {{ forloop.index0 | times: 0.1 }}s;" {{ block.shopify_attributes }}>
          <div class="mt-paso__media">
            <span class="mt-paso__num">{{ forloop.index }}</span>
            {%- if block.settings.imagen != blank -%}
              <img src="{{ block.settings.imagen | image_url: width: 700 }}" alt="{{ block.settings.imagen.alt | escape }}" width="700" height="933" loading="lazy">
            {%- else -%}
              <img src="{{ 'mt-paso-' | append: forloop.index | append: '.jpg' | asset_url }}" alt="" width="700" height="933" loading="lazy">
            {%- endif -%}
          </div>
          <h3 class="mt-paso__title">{{ block.settings.titulo }}</h3>
          <p class="mt-paso__text">{{ block.settings.texto }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT — Cómo se usa",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "The Orlure Ritual" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Your ritual in 3 steps" },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto" },
        { "type": "text", "id": "titulo", "label": "Título" },
        { "type": "textarea", "id": "texto", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT — Cómo se usa",
      "blocks": [
        { "type": "paso", "settings": { "titulo": "Prep", "texto": "Add a few drops of your favorite serum or oil to the 6ML reservoir." } },
        { "type": "paso", "settings": { "titulo": "Massage", "texto": "Glide the brush over your scalp with the red light and your favorite vibration mode on." } },
        { "type": "paso", "settings": { "titulo": "Enjoy", "texto": "Just 3-5 minutes a day is enough to feel a more relaxed scalp and see shinier hair." } }
      ]
    }
  ]
}
{% endschema %}
