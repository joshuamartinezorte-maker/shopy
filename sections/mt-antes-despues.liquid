{{ 'mt-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mt-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--mt-color-fondo-alt);
  }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

<section class="mt-section">
  <div class="mt-container">
    <div class="mt-pasos__head mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<div class="mt-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="mt-h2">{{ section.settings.headline }}</h2>
      {%- if section.settings.subheadline != blank -%}<p class="mt-body-text" style="margin-top:14px;">{{ section.settings.subheadline }}</p>{%- endif -%}
    </div>

    <div class="mt-comparador mt-reveal" data-mt-comparador
         style="position:relative; max-width:720px; margin:0 auto; aspect-ratio:4/3; border-radius:var(--mt-radio); overflow:hidden; border:1px solid var(--mt-color-borde); cursor:ew-resize; user-select:none;">
      <div style="position:absolute; inset:0;">
        {%- if section.settings.imagen_despues != blank -%}
          <img src="{{ section.settings.imagen_despues | image_url: width: 1200 }}" alt="{{ section.settings.texto_despues }}" style="width:100%;height:100%;object-fit:cover;display:block;" width="1200" height="900" loading="lazy">
        {%- else -%}
          <img src="{{ 'mt-despues.jpg' | asset_url }}" alt="{{ section.settings.texto_despues }}" style="width:100%;height:100%;object-fit:cover;display:block;" width="1200" height="900" loading="lazy">
        {%- endif -%}
      </div>
      <div data-mt-comparador-antes style="position:absolute; inset:0; width:50%; overflow:hidden;">
        {%- if section.settings.imagen_antes != blank -%}
          <img src="{{ section.settings.imagen_antes | image_url: width: 1200 }}" alt="{{ section.settings.texto_antes }}" style="width:200%;max-width:none;height:100%;object-fit:cover;display:block;" width="1200" height="900" loading="lazy">
        {%- else -%}
          <img src="{{ 'mt-antes.jpg' | asset_url }}" alt="{{ section.settings.texto_antes }}" style="width:200%;max-width:none;height:100%;object-fit:cover;display:block;" width="1200" height="900" loading="lazy">
        {%- endif -%}
      </div>
      <div data-mt-comparador-linea style="position:absolute; top:0; bottom:0; left:50%; width:3px; background:var(--mt-color-dorado-suave); transform:translateX(-50%); box-shadow:0 0 12px rgba(0,0,0,0.5);">
        <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:40px; height:40px; border-radius:50%; background:var(--mt-gradiente-dorado); display:flex; align-items:center; justify-content:center; color:#1a0a0e; font-weight:700; font-size:13px;">↔</div>
      </div>
      <span style="position:absolute; bottom:14px; left:14px; background:rgba(13,5,7,0.65); backdrop-filter:blur(6px); padding:6px 14px; border-radius:999px; font-size:12.5px; letter-spacing:0.06em; text-transform:uppercase;">{{ section.settings.texto_antes }}</span>
      <span style="position:absolute; bottom:14px; right:14px; background:rgba(13,5,7,0.65); backdrop-filter:blur(6px); padding:6px 14px; border-radius:999px; font-size:12.5px; letter-spacing:0.06em; text-transform:uppercase;">{{ section.settings.texto_despues }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT — Antes / Después",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Resultados" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Antes y después" },
    { "type": "textarea", "id": "subheadline", "label": "Texto bajo el título", "default": "Desliza para ver la diferencia con el uso constante del ritual Orlure." },
    { "type": "image_picker", "id": "imagen_antes", "label": "Foto \"antes\"" },
    { "type": "image_picker", "id": "imagen_despues", "label": "Foto \"después\"" },
    { "type": "text", "id": "texto_antes", "label": "Etiqueta \"antes\"", "default": "Antes" },
    { "type": "text", "id": "texto_despues", "label": "Etiqueta \"después\"", "default": "Después" },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [ { "name": "MT — Antes / Después" } ]
}
{% endschema %}
