{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--mt-color-fondo);
  }
  #shopify-section-{{ section.id }} .mt-h2 { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

<section class="mt-beneficios mt-section">
  <div class="mt-container">
    <div class="mt-beneficios__head mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<div class="mt-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 class="mt-h2">{{ section.settings.headline }}</h2>
      {%- if section.settings.subheadline != blank -%}<p class="mt-body-text" style="margin-top:14px;">{{ section.settings.subheadline }}</p>{%- endif -%}
    </div>

    <div class="mt-beneficios__grid">
      {%- for block in section.blocks -%}
        <div class="mt-beneficio-card mt-reveal" style="transition-delay: {{ forloop.index0 | times: 0.08 }}s;" {{ block.shopify_attributes }}>
          <div class="mt-beneficio-card__media">
            {%- if block.settings.imagen != blank -%}
              <img src="{{ block.settings.imagen | image_url: width: 600 }}" alt="{{ block.settings.imagen.alt | escape }}" width="600" height="600" loading="lazy">
            {%- else -%}
              <img src="{{ 'mt-beneficio-' | append: forloop.index | append: '.jpg' | asset_url }}" alt="" width="600" height="600" loading="lazy">
            {%- endif -%}
          </div>
          <h3 class="mt-beneficio-card__title">{{ block.settings.titulo }}</h3>
          <p class="mt-beneficio-card__text">{{ block.settings.texto }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT — Beneficios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Por qué Orlure" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Tecnología pensada para tu cuero cabelludo" },
    { "type": "textarea", "id": "subheadline", "label": "Texto bajo el título", "default": "Cuatro razones por las que se ha convertido en el ritual favorito de miles de personas." },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto" },
        { "type": "text", "id": "titulo", "label": "Título" },
        { "type": "textarea", "id": "texto", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT — Beneficios",
      "blocks": [
        { "type": "beneficio", "settings": { "titulo": "Luz roja 630nm", "texto": "Infrarrojo que llega a la raíz para estimular el cuero cabelludo en cada sesión." } },
        { "type": "beneficio", "settings": { "titulo": "3 modos de masaje", "texto": "Vibración tipo EMS con tres intensidades, de un descanso rápido a un masaje profundo." } },
        { "type": "beneficio", "settings": { "titulo": "Depósito de sérum", "texto": "6ML para infundir tu aceite o sérum capilar favorito mientras masajeas." } },
        { "type": "beneficio", "settings": { "titulo": "Diseño ergonómico", "texto": "Ligero, inalámbrico y fácil de sujetar, pensado para el uso diario." } }
      ]
    }
  ]
}
{% endschema %}
